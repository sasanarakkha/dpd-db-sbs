#!/bin/bash

set -euo pipefail # Exit on error, treat unset variables as error, pipeline fails on first error

# Script to synchronize sbs-ru branch from as_upstream,
# offering a choice between full sync or selective sync based on predefined lists.

PROJECT_DIR="$HOME/Documents/dpd-db"
# files that should be preserved from sbs-ru
# Read exclusions dynamically from conductor/templates/upstream_sync_rehearsal/dps_sync_registry.json
# Extract 'modified_upstream_files' list using python
echo "ℹ️ Reading exclusions from conductor/templates/upstream_sync_rehearsal/dps_sync_registry.json..."
export PROJECT_DIR
EXCLUDE_FILES=()
while IFS= read -r line; do
    EXCLUDE_FILES+=("$line")
done < <(python3 -c 'import json, os; data = json.load(open(os.path.join(os.environ["PROJECT_DIR"], "conductor/templates/upstream_sync_rehearsal/dps_sync_registry.json"))); print("\n".join(data["modified_upstream_files"] + data["ignored_files"]))')

# Check if we successfully got exclusions
if [ ${#EXCLUDE_FILES[@]} -eq 0 ]; then
    echo "⚠️ Warning: No exclusions found or failed to parse registry."
else
    echo "✅ Loadded ${#EXCLUDE_FILES[@]} exclusions."
fi

cd "$PROJECT_DIR" || exit 1

# Update as_upstream branch
echo "ℹ️ Updating as_upstream branch to match upstream/main..."
git checkout as_upstream || exit 1
# The following pull was in the original but is redundant if resetting to upstream/main immediately after.
# git pull origin as_upstream || exit 1
git fetch upstream || exit 1
git reset --hard upstream/main || exit 1

# Switch to sbs-ru and sync
echo "ℹ️ Switching to sbs-ru branch..."
git checkout sbs-ru || exit 1
SBR_RU_ORIGINAL_SHA=$(git rev-parse HEAD) # Capture SHA of sbs-ru before modifications

echo ""
echo "--------------------------------------------------"
echo "How would you like to sync to sbs-ru?"
echo "--------------------------------------------------"
echo "1. Full Sync (Recommended: Overwrites sbs-ru with all content from as_upstream)"
echo "2. Selective Sync (Original logic: Syncs specific folders/files, preserves exclusions from sbs-ru)"
echo "3. Single Folder Sync (Syncs only one specified folder from as_upstream)"
echo "--------------------------------------------------"
read -r -p "Enter your choice (1, 2 or 3): " sync_choice
echo ""

DATE=$(date +"%d-%m")
COMMIT_MESSAGE_PREFIX="sync: "
COMMIT_MESSAGE_SUFFIX=" from as_upstream ($DATE)"

if [[ "$sync_choice" == "1" ]]; then
    echo "🔄 Performing Full Sync from as_upstream to sbs-ru..."
    git checkout as_upstream -- . || exit 1
    COMMIT_MESSAGE="${COMMIT_MESSAGE_PREFIX}full update${COMMIT_MESSAGE_SUFFIX}"
elif [[ "$sync_choice" == "2" ]]; then
    echo "🔄 Performing Selective Sync from as_upstream to sbs-ru..."
    
    echo "  ➡️ Performing full checkout from as_upstream..."
    git checkout as_upstream -- . || exit 1

    echo "  ➡️ Restoring excluded files from sbs-ru..."
    for EXCLUDED_FILE in "${EXCLUDE_FILES[@]}"; do
        echo "    - Processing excluded file: $EXCLUDED_FILE"
        
        # Check if file existed in original sbs-ru state
        if git rev-parse --verify "${SBR_RU_ORIGINAL_SHA}:${EXCLUDED_FILE}" >/dev/null 2>&1; then
            echo "      Restoring usage of $EXCLUDED_FILE from $SBR_RU_ORIGINAL_SHA..."
            git restore --source="$SBR_RU_ORIGINAL_SHA" --staged --worktree "$EXCLUDED_FILE" || \
                echo "      ⚠️ Warning: Failed to restore $EXCLUDED_FILE from $SBR_RU_ORIGINAL_SHA."
        else
            # File did not exist in sbs-ru
            if [ -e "$EXCLUDED_FILE" ]; then 
                echo "      $EXCLUDED_FILE did not exist in $SBR_RU_ORIGINAL_SHA, removing it as it was added by as_upstream."
                git rm -r --cached --ignore-unmatch "$EXCLUDED_FILE" >/dev/null 2>&1
                rm -rf "$EXCLUDED_FILE"
            else
                echo "      $EXCLUDED_FILE did not exist in sbs-ru and does not exist now. Nothing to do."
            fi
        fi
    done

    echo "  ➕ Staging changes..."
    git add . || exit 1
    COMMIT_MESSAGE="${COMMIT_MESSAGE_PREFIX}selective update${COMMIT_MESSAGE_SUFFIX}"
elif [[ "$sync_choice" == "3" ]]; then
    SYNCED_ITEMS=()
    while true; do
        echo "🔄 Performing Single Folder Sync..."
        echo "Available folders in root:"
        # List only directories in the root of the repository
        find . -maxdepth 1 -type d -not -path '*/.*' -not -path '.' | sed 's|./||' | sort
        echo ""
        read -r -p "Enter the folder name to sync (or / for root files): " target_folder
        
        if [ -z "$target_folder" ]; then
            echo "⚠️ No input provided. Skipping."
        elif [[ "$target_folder" == "/" ]]; then
            echo "  ➡️ Syncing root files from as_upstream..."
            # Get list of files (blobs) in the root of as_upstream
            ROOT_FILES=$(git ls-tree as_upstream -- | grep "blob" | awk '{print $4}' || true)
            
            if [ -z "$ROOT_FILES" ]; then
                echo "⚠️ No root files found in as_upstream."
            else
                echo "    - Processing root files..."
                # shellcheck disable=SC2086
                git checkout as_upstream -- $ROOT_FILES || exit 1
                # shellcheck disable=SC2086
                git add $ROOT_FILES || exit 1
                SYNCED_ITEMS+=("root files")
            fi
        else
            if ! git rev-parse --verify "as_upstream:${target_folder}" >/dev/null 2>&1; then
                echo "❌ Folder '$target_folder' does not exist in as_upstream branch."
            else
                echo "  ➡️ Checking out '$target_folder' from as_upstream..."
                git checkout as_upstream -- "$target_folder" || exit 1
                
                echo "  ➕ Staging changes for '$target_folder'..."
                git add "$target_folder" || exit 1
                SYNCED_ITEMS+=("$target_folder")
            fi
        fi

        echo ""
        read -r -p "Add another folder? [y/Enter for continue]: " another
        if [[ ! "$another" =~ ^[Yy]$ ]]; then
            break
        fi
        echo ""
    done

    if [ ${#SYNCED_ITEMS[@]} -eq 0 ]; then
        echo "⚠️ No items were synced. Exiting."
        exit 0
    fi

    # Create comma-separated list for commit message
    ITEMS_LIST=$(IFS=,; echo "${SYNCED_ITEMS[*]}")
    COMMIT_MESSAGE="${COMMIT_MESSAGE_PREFIX}update $ITEMS_LIST${COMMIT_MESSAGE_SUFFIX}"
else
    echo "❌ Invalid choice: $sync_choice. Exiting."
    exit 1
fi

# Run font scaling helper (keep disabled for now!)
# echo "ℹ️ Running font scaling helper..."
# uv run python gui2/font_scaling_helper.py || { echo "⚠️ Font scaling helper failed."; exit 1; }

# Add changes again to include font scaling modifications
echo "  ➕ Staging all changes (including scaled fonts)..."
git add . || exit 1

echo ""
echo "--------------------------------------------------"
echo "🔍 Review staged changes:"
git status --short
echo "--------------------------------------------------"

if [ -f "$PROJECT_DIR/scripts/bash/dpd-sync-assertions.sh" ]; then
    bash "$PROJECT_DIR/scripts/bash/dpd-sync-assertions.sh" "$SBR_RU_ORIGINAL_SHA"
fi

read -r -p "Press [Enter] to commit or 'q' to quit: " confirm_commit
if [[ "$confirm_commit" == "q" ]]; then
    echo "❌ Sync cancelled by user. No changes committed."
    exit 0
fi

# Commit changes with date
echo "📝 Committing changes to sbs-ru..."
git commit -m "$COMMIT_MESSAGE" || { 
    echo "⚠️ Commit failed. This might be because there are no changes to commit."
    echo "   If you expected changes, please review the output above."
    # Check if there are any staged changes. If not, it's a "no changes" scenario.
    if git diff --staged --quiet; then
        echo "   No changes were staged for commit. Sync resulted in current state."
        # Exit gracefully if no changes
        echo "✅ Done (no changes to commit)."
        exit 0
    fi
    exit 1; # Exit with error if commit failed for other reasons
}

echo "✅ Done!"
