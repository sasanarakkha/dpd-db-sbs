#!/bin/bash
# Initialize a new upstream sync kamma thread and register it in kamma/threads.md.
set -euo pipefail

PROJECT_DIR="$HOME/Documents/dpd-db"
cd "$PROJECT_DIR"

INIT_SCRIPT="scripts/cl_dps/dpd_init_sync.py"

if [ -f "$INIT_SCRIPT" ]; then
    uv run python3 "$INIT_SCRIPT"
else
    echo "❌ Error: $INIT_SCRIPT not found in $PROJECT_DIR"
    exit 1
fi
