#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$HOME/Documents/dpd-db"
FILES=(
    gui2/data/additions_deva.json
    gui2/data/corrections_deva.json
)

cd "$PROJECT_DIR"

uv run tools/ask.py --print -c green "Switching to as_upstream..."
git checkout as_upstream
uv run tools/ask.py --print -c cyan "Pulling latest from upstream..."
git pull upstream main

uv run tools/ask.py --print -c green "Copying additions + corrections from sbs-ru..."
for FILE in "${FILES[@]}"; do
    git checkout sbs-ru -- "$FILE"
done

git add "${FILES[@]}"
git commit -m "additions and corrections"

uv run tools/ask.py --print -c yellow "About to push: ${FILES[*]}"
confirm=$(uv run tools/ask.py -c yellow "Push to upstream remote? [y/n] ")
if [ "$confirm" != "y" ]; then
    git checkout sbs-ru
    uv run tools/ask.py --print -c red "Cancelled. Returned to sbs-ru."
    exit 0
fi

git push upstream as_upstream:main

git checkout sbs-ru

uv run tools/ask.py --print -c green "Clearing local JSON files..."
echo '{}' > gui2/data/additions_deva.json
echo '{}' > gui2/data/corrections_deva.json

uv run tools/ask.py --print -c green "Done."
