#!/bin/bash
# Interactive CLI wrapper for building and distributing DPD dictionaries.

PROJECT_ROOT="$HOME/Documents/dpd-db"

MASTER_SCRIPT="$HOME/.local/bin/run_and_log.sh"

LOG_BASE_NAME="make_dpd"
TARGET_SCRIPT_PATH="${PROJECT_ROOT}/scripts/bash/make_dpd.sh"
TARGET_SCRIPT_PATH_RU="${PROJECT_ROOT}/scripts/bash/make_ru_dpd.sh"
TARGET_SCRIPT_PATH_COPY="${PROJECT_ROOT}/scripts/bash/copy_dpd_to_server.sh"
TARGET_SCRIPT_PATH_COPY_TPR="${PROJECT_ROOT}/scripts/moving/distribute.py"

# The command to run, including 'uv run bash'
COMMAND_TO_EXECUTE=(bash -c "cd '${PROJECT_ROOT}' && uv run bash '${TARGET_SCRIPT_PATH}'")
COMMAND_TO_EXECUTE_RU=(bash -c "cd '${PROJECT_ROOT}' && uv run bash '${TARGET_SCRIPT_PATH_RU}'")
COMMAND_TO_EXECUTE_COPY=(bash -c "cd '${PROJECT_ROOT}' && uv run bash '${TARGET_SCRIPT_PATH_COPY}'")
COMMAND_TO_EXECUTE_COPY_TPR=(bash -c "cd '${PROJECT_ROOT}' && uv run python '${TARGET_SCRIPT_PATH_COPY_TPR}' copy_dpd_for_classes")

prompt_and_run() {
    local prompt="$1"
    shift
    local answer
    answer=$(uv run tools/ask.py -c cyan "$prompt")
    if [[ $answer == "y" ]]; then
        "$@"
    fi
}

prompt_and_run "make DPD?" bash "${MASTER_SCRIPT}" "${LOG_BASE_NAME}" "${COMMAND_TO_EXECUTE[@]}"
prompt_and_run "make RU-DPD?" bash "${MASTER_SCRIPT}" "${LOG_BASE_NAME}" "${COMMAND_TO_EXECUTE_RU[@]}"
prompt_and_run "Do you want to attempt to mount the fileserver?" mnt
prompt_and_run "copy DPD+SBS?" bash "${MASTER_SCRIPT}" "${LOG_BASE_NAME}" "${COMMAND_TO_EXECUTE_COPY[@]}"
prompt_and_run "copy DPD + TPR for class?" bash "${MASTER_SCRIPT}" "${LOG_BASE_NAME}" "${COMMAND_TO_EXECUTE_COPY_TPR[@]}"
prompt_and_run "Do you want to umount the fileserver?" umnt
