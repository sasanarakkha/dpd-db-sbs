#!/bin/bash
set -euo pipefail

# Wrapper for conductor/init_rehearsal.py

PROJECT_DIR="$HOME/Documents/dpd-db"
cd "$PROJECT_DIR"

if [ -f "conductor/init_rehearsal.py" ]; then
    echo "🚀 Initializing new Upstream Sync Rehearsal track..."
    uv run python3 conductor/init_rehearsal.py
else
    echo "❌ Error: conductor/init_rehearsal.py not found in $PROJECT_DIR"
    exit 1
fi
