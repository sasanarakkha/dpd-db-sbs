#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$HOME/Documents/dpd-db"
MASTER_SCRIPT="$HOME/.local/bin/run_and_log.sh"
LOG_BASE_NAME="anki_update"

run() {
    bash "$MASTER_SCRIPT" "$LOG_BASE_NAME" bash -c "cd '$PROJECT_ROOT' && uv run python3 '$1' ${2:-}"
}

# fix chants before testing
run "$PROJECT_ROOT/scripts/change_in_db/update_sbs_chants_in_db.py"

# run tests — abort on failure
if ! run "$PROJECT_ROOT/db_tests/sbs_consistency_tests.py"; then
    uv run tools/ask.py --print --color red "SBS consistency tests FAILED. Aborting Anki update."
    exit 1
fi

answer=$(uv run tools/ask.py "Update 'test' and 'feedback' fields in Anki notes?")
case "${answer,,}" in
    y*)
        uv run tools/ask.py --print --color green "Updating test/feedback fields..."
        run "$PROJECT_ROOT/scripts/export/dps_anki_updater.py" "test"
        ;;
    *)
        uv run tools/ask.py --print --color cyan "Running without updating test/feedback fields..."
        run "$PROJECT_ROOT/scripts/export/dps_anki_updater.py"
        ;;
esac
