#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$HOME/Documents/dpd-db"
cd "$PROJECT_DIR"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" == "as_upstream" ]; then
    echo "You are already on as_upstream branch. This script should be run from your feature branch."
    exit 1
fi

# Get files changed in the latest commit
# Using mapfile to handle potential spaces in filenames correctly, though unlikely in this repo
FILES=()
while IFS= read -r line; do
    FILES+=("$line")
done < <(git diff-tree --no-commit-id --name-only -r HEAD)

if [ ${#FILES[@]} -eq 0 ]; then
    echo "No files found in the latest commit."
    exit 0
fi

echo "Found ${#FILES[@]} changed files in latest commit of $CURRENT_BRANCH:"
printf '%s\n' "${FILES[@]}"

COMMIT_MSG=$(git log -1 --pretty=%B)

# Checkout as_upstream branch and update from upstream
echo "Switching to as_upstream..."
git checkout as_upstream
git pull upstream main

# Copy files from original branch
echo "Checking out files from $CURRENT_BRANCH..."
for FILE in "${FILES[@]}"; do
    # check if file exists in the source branch (it might be a deletion)
    if git cat-file -e "$CURRENT_BRANCH:$FILE" 2>/dev/null; then
        git checkout "$CURRENT_BRANCH" -- "$FILE"
    else
        echo "File $FILE was deleted in source, deleting in destination..."
        rm -f "$FILE"
    fi
done

# Add and commit
echo "Committing..."
git add -A # Use -A to handle deletions as well
git commit -m "$COMMIT_MSG"

# Push to upstream
echo "Pushing to upstream..."
git push upstream as_upstream:main

# Return to previous branch
echo "Returning to $CURRENT_BRANCH..."
git checkout "$CURRENT_BRANCH"

echo "Done."
