#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$HOME/Documents/dpd-db"
cd "$PROJECT_DIR"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" == "as_upstream" ]; then
    uv run tools/ask.py -c red "You are already on as_upstream branch. This script should be run from your feature branch."
    exit 1
fi

FILES=()
while IFS= read -r line; do
    FILES+=("$line")
done < <(git diff-tree --no-commit-id --name-only -r HEAD)

if [ ${#FILES[@]} -eq 0 ]; then
    uv run tools/ask.py -c yellow "No files found in the latest commit."
    exit 0
fi

uv run tools/ask.py --print -c cyan "Found ${#FILES[@]} changed files in latest commit of $CURRENT_BRANCH:"
for f in "${FILES[@]}"; do uv run tools/ask.py --print "  $f"; done

COMMIT_MSG=$(git log -1 --pretty=%B)

uv run tools/ask.py --print -c green "Switching to as_upstream..."
git checkout as_upstream
git pull upstream main

uv run tools/ask.py --print -c green "Checking out files from $CURRENT_BRANCH..."
for FILE in "${FILES[@]}"; do
    if git cat-file -e "$CURRENT_BRANCH:$FILE" 2>/dev/null; then
        git checkout "$CURRENT_BRANCH" -- "$FILE"
    else
        uv run tools/ask.py --print -c yellow "  $FILE deleted in source, deleting in destination..."
        rm -f "$FILE"
    fi
    git add "$FILE"
done

uv run tools/ask.py --print -c green "Committing..."
git commit -m "$COMMIT_MSG"

uv run tools/ask.py --print -c cyan "Files committed:"
git diff --name-only HEAD^ HEAD

confirm=$(uv run tools/ask.py -c yellow "Push to upstream remote? [Press enter to push, q to abort] ")

uv run tools/ask.py --print -c green "Pushing to upstream..."
git push upstream as_upstream:main

uv run tools/ask.py --print -c green "Returning to $CURRENT_BRANCH..."
git checkout "$CURRENT_BRANCH"

uv run tools/ask.py --print -c green "Done."
