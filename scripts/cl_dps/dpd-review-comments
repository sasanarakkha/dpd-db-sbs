#!/bin/bash
# dpd-review-comments — run corrections review then additions review sequentially.

set -e

PROJECT_ROOT="$(dirname "$(realpath "$0")")/../.."

uv run tools/ask.py --print -c cyan "──────────────────────────────────────────"
uv run tools/ask.py --print -c cyan "Step 1: Reviewing Corrections"
uv run tools/ask.py --print -c cyan "──────────────────────────────────────────"
cd "${PROJECT_ROOT}" && uv run python3 gui2/dps_process_corrections.py

uv run tools/ask.py --print -c cyan ""
uv run tools/ask.py --print -c cyan "──────────────────────────────────────────"
uv run tools/ask.py --print -c cyan "Step 2: Reviewing Additions"
uv run tools/ask.py --print -c cyan "──────────────────────────────────────────"
cd "${PROJECT_ROOT}" && uv run python3 gui2/dps_process_additions.py

uv run tools/ask.py --print -c green "All reviews completed."
