#!/bin/bash

set -euo pipefail # Exit on error, treat unset variables as error, pipeline fails on first error

# Script to synchronize sbs-ru branch from as_upstream,
# offering a choice between full sync or selective sync based on predefined lists.

PROJECT_DIR="$HOME/Documents/dpd-db"
FOLDERS=(
    db_tests
    db_tests_gui
    docs
    go_modules
    gui2
    scripts
    tools
)
FILES=(
    .gitattributes
    .gitmodules
    go.mod
    go.sum
    mkdocs.yaml
    pyproject.toml
    README.md
)

# EXCLUDE_FOLDERS specifies subpaths within items in FOLDERS that should be preserved from sbs-ru
EXCLUDE_FOLDERS=(
    scripts/cl
)
EXCLUDE_FILES=(
    tools/fast_api_utils.py
    tools/goldendict_exporter.py
    tools/utils.py
    scripts/bash/generate_components.sh
)

cd "$PROJECT_DIR" || exit 1

# Update as_upstream branch
echo "ℹ️ Updating as_upstream branch to match upstream/main..."
git checkout as_upstream || exit 1
# The following pull was in the original but is redundant if resetting to upstream/main immediately after.
# git pull origin as_upstream || exit 1
git fetch upstream || exit 1
git reset --hard upstream/main || exit 1

# Switch to sbs-ru and sync
echo "ℹ️ Switching to sbs-ru branch..."
git checkout sbs-ru || exit 1
SBR_RU_ORIGINAL_SHA=$(git rev-parse HEAD) # Capture SHA of sbs-ru before modifications

echo ""
echo "--------------------------------------------------"
echo "How would you like to sync to sbs-ru?"
echo "--------------------------------------------------"
echo "1. Full Sync (Recommended: Overwrites sbs-ru with all content from as_upstream)"
echo "2. Selective Sync (Original logic: Syncs specific folders/files, preserves exclusions from sbs-ru)"
echo "--------------------------------------------------"
read -r -p "Enter your choice (1 or 2): " sync_choice
echo ""

DATE=$(date +"%d-%m")
COMMIT_MESSAGE_PREFIX="sync: "
COMMIT_MESSAGE_SUFFIX=" from as_upstream ($DATE)"

if [[ "$sync_choice" == "1" ]]; then
    echo "🔄 Performing Full Sync from as_upstream to sbs-ru..."
    git checkout as_upstream -- . || exit 1
    COMMIT_MESSAGE="${COMMIT_MESSAGE_PREFIX}full update${COMMIT_MESSAGE_SUFFIX}"
elif [[ "$sync_choice" == "2" ]]; then
    echo "🔄 Performing Selective Sync from as_upstream to sbs-ru..."

    echo "  ➡️ Syncing specified folders (with exclusions from sbs-ru):"
    for FOLDER in "${FOLDERS[@]}"; do
        echo "    - Processing folder $FOLDER (initially from as_upstream)"
        # Checkout the entire folder from as_upstream first
        git checkout as_upstream -- "$FOLDER" || { echo "    ⚠️ Error checking out $FOLDER from as_upstream. Skipping preserve logic for this folder."; continue; }

        # Preserve excluded sub-folders within this FOLDER
        for EXCLUDED_SUBFOLDER in "${EXCLUDE_FOLDERS[@]}"; do
            # Check if EXCLUDED_SUBFOLDER is a subpath of FOLDER
            if [[ "$EXCLUDED_SUBFOLDER" == "$FOLDER/"* ]]; then
                echo "      Restoring excluded subfolder $EXCLUDED_SUBFOLDER to its state from sbs-ru (commit $SBR_RU_ORIGINAL_SHA)..."
                if git rev-parse --verify "${SBR_RU_ORIGINAL_SHA}:${EXCLUDED_SUBFOLDER}" >/dev/null 2>&1; then
                    git restore --source="$SBR_RU_ORIGINAL_SHA" --staged --worktree "$EXCLUDED_SUBFOLDER" || \
                        echo "      ⚠️ Warning: Failed to restore $EXCLUDED_SUBFOLDER from $SBR_RU_ORIGINAL_SHA."
                else
                    if [ -e "$EXCLUDED_SUBFOLDER" ]; then # Check if it exists in the working tree now
                        echo "      $EXCLUDED_SUBFOLDER did not exist in $SBR_RU_ORIGINAL_SHA, removing it as it was likely added by as_upstream's $FOLDER."
                        git rm -r --cached --ignore-unmatch "$EXCLUDED_SUBFOLDER" >/dev/null 2>&1
                        rm -rf "$EXCLUDED_SUBFOLDER"
                    else
                        echo "      $EXCLUDED_SUBFOLDER did not exist in $SBR_RU_ORIGINAL_SHA and does not exist now. Nothing to do for preservation."
                    fi
                fi
            fi
        done

        # Preserve excluded files within this FOLDER
        for EXCLUDED_FILE in "${EXCLUDE_FILES[@]}"; do
            # Check if EXCLUDED_FILE is a subpath of FOLDER
            if [[ "$EXCLUDED_FILE" == "$FOLDER/"* ]]; then
                echo "      Restoring excluded file $EXCLUDED_FILE to its state from sbs-ru (commit $SBR_RU_ORIGINAL_SHA)..."
                if git rev-parse --verify "${SBR_RU_ORIGINAL_SHA}:${EXCLUDED_FILE}" >/dev/null 2>&1; then
                    git restore --source="$SBR_RU_ORIGINAL_SHA" --staged --worktree "$EXCLUDED_FILE" || \
                        echo "      ⚠️ Warning: Failed to restore $EXCLUDED_FILE from $SBR_RU_ORIGINAL_SHA."
                else
                    if [ -e "$EXCLUDED_FILE" ]; then # Check if it exists in the working tree now
                        echo "      $EXCLUDED_FILE did not exist in $SBR_RU_ORIGINAL_SHA, removing it as it was likely added by as_upstream's $FOLDER."
                        git rm --cached --ignore-unmatch "$EXCLUDED_FILE" >/dev/null 2>&1
                        rm -f "$EXCLUDED_FILE"
                    else
                        echo "      $EXCLUDED_FILE did not exist in $SBR_RU_ORIGINAL_SHA and does not exist now. Nothing to do for preservation."
                    fi
                fi
            fi
        done
    done

    echo "  ➡️ Syncing specified top-level files (with exclusions from sbs-ru):"
    for FILE in "${FILES[@]}"; do
        IS_FILE_EXCLUDED=false
        for EXCL_F in "${EXCLUDE_FILES[@]}"; do
            if [[ "$FILE" == "$EXCL_F" ]]; then
                IS_FILE_EXCLUDED=true
                break
            fi
        done

        if [[ "$IS_FILE_EXCLUDED" == "true" ]]; then
            echo "    - $FILE (is excluded, ensuring sbs-ru version is preserved)"
            # Attempt to checkout from as_upstream; don't fail hard if it's not there, SBR_RU_ORIGINAL_SHA state is key.
            git checkout as_upstream -- "$FILE" >/dev/null 2>&1 || \
                echo "      Note: $FILE not found in as_upstream. Will ensure sbs-ru state is preserved/restored."
            
            echo "      Restoring $FILE to its state from sbs-ru (commit $SBR_RU_ORIGINAL_SHA)..."
            if git rev-parse --verify "${SBR_RU_ORIGINAL_SHA}:${FILE}" >/dev/null 2>&1; then
                git restore --source="$SBR_RU_ORIGINAL_SHA" --staged --worktree "$FILE" || \
                    echo "    ⚠️ Warning: Failed to restore $FILE from $SBR_RU_ORIGINAL_SHA."
            else
                if [ -e "$FILE" ]; then 
                    echo "      $FILE did not exist in $SBR_RU_ORIGINAL_SHA, removing it as it was added by as_upstream but is in EXCLUDE_FILES."
                    git rm --cached --ignore-unmatch "$FILE" >/dev/null 2>&1
                    rm -f "$FILE"
                else
                    echo "      $FILE did not exist in $SBR_RU_ORIGINAL_SHA and does not exist now. Nothing to do for preservation."
                fi
            fi
        else
            echo "    - $FILE (fully from as_upstream)"
            git checkout as_upstream -- "$FILE" || { echo "    ⚠️ Error checking out $FILE from as_upstream."; exit 1; }
        fi
    done

    echo "  ➕ Staging selected folders and files for commit..."
    git add "${FOLDERS[@]}" "${FILES[@]}" || exit 1 # Add the top-level items we processed.
    COMMIT_MESSAGE="${COMMIT_MESSAGE_PREFIX}selective update${COMMIT_MESSAGE_SUFFIX}"
else
    echo "❌ Invalid choice: $sync_choice. Exiting."
    exit 1
fi

# Commit changes with date
echo "📝 Committing changes to sbs-ru..."
git commit -m "$COMMIT_MESSAGE" || { 
    echo "⚠️ Commit failed. This might be because there are no changes to commit."
    echo "   If you expected changes, please review the output above."
    # Check if there are any staged changes. If not, it's a "no changes" scenario.
    if git diff --staged --quiet; then
        echo "   No changes were staged for commit. Sync resulted in current state."
        # Exit gracefully if no changes
        echo "✅ Done (no changes to commit)."
        exit 0
    fi
    exit 1; # Exit with error if commit failed for other reasons
}

echo "✅ Done!"
