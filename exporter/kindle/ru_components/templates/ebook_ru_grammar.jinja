<table class="grammar">
    <tr>
        <td class='th'>English</td>
        <td>{{ meaning }}</td>
    </tr>
    <tr>
        <td class='th'>Грамматика</td>
        <td>{{ grammar }}</td>
    </tr>
{% if i.family_root %}
    <tr>
        <td class='th'>Семья Корня</td>
        <td>{{ i.family_root }}</td>
    </tr>
{% endif %}
{% if i.root_key %}
    <tr>
        <td class='th'>Корень</td>
        <td>{{ i.root_clean }}<sup>{{ i.rt.root_has_verb }}</sup>{{ i.rt.root_group }} 
            {{ i.root_sign }} ({{ i.rt.root_ru_meaning }})
        </td>
    </tr>
{% if i.rt.root_in_comps %}
    <tr>
        <td class='th'>√ В сочет.</td>
        <td>{{ i.rt.root_in_comps }}</td>
    </tr>
{% endif %}
{% endif %}
{% if friendly.root_base %}
    <tr>
        <td class='th'>Основа</td>
        <td>{{ friendly.root_base }}</td>
    </tr>
{% endif %}
{% if friendly.construction %}
    <tr>
        <td class='th'>Образование</td>
        <td>{{ friendly.construction }}</td>
    </tr>
{% endif %}
{% if i.derivative %}
    <tr>
        <td class='th'>Производное</td>
        <td>{{ i.derivative }} ({{ i.suffix }})</td>
    </tr>
{% endif %}
{% if friendly.phonetic %}
    <tr>
        <td class='th'>Фонетика</td>
        <td>{{ friendly.phonetic }}</td>
    </tr>
{% endif %}
{% if friendly.compound_type and "?" not in friendly.compound_type %}
    <tr>
        <td class='th'>Составное</td>
        <td>{{ friendly.compound_type }} ({{ i.compound_construction }})</td>
    </tr>
{% endif %}
{% if i.antonym %}
    <tr>
        <td class='th'>Антоним</td>
        <td>{{ i.antonym }}</td>
    </tr>
{% endif %}
{% if i.synonym %}
    <tr>
        <td class='th'>Синоним</td>
        <td>{{ i.synonym }}</td>
    </tr>
{% endif %}
{% if i.variant %}
    <tr>
        <td class='th'>Вариант</td>
        <td>{{ i.variant }}</td>
    </tr>
{% endif %}
{% if (friendly.commentary and friendly.commentary != "-") %}
    <tr>
        <td class='th'>Комментарий</td>
        <td>{{ friendly.commentary }}</td>
    </tr>
{% endif %}
{% if friendly.ru_notes %}
    <tr>
        <td class='th'>Заметки</td>
        <td>{{ friendly.ru_notes }}</td>
    </tr>
{% if "[пер. ИИ]" in friendly.ru_notes and friendly.notes %}
            <tr>
                <td class='th'>Notes</td>
                <td>{{ friendly.notes }}</td>
            </tr>
{% endif %}
{% elif friendly.notes %}
    <tr>
        <td class='th'>Notes</td>
        <td>{{ friendly.notes }}</td>
    </tr>
{% endif %}
{% if friendly.cognate %}
    <tr>
        <td class='th'>English Cognate</td>
        <td>{{ friendly.cognate }}</td>
    </tr>
{% endif %}
{% if i.link %}
    <tr>
        <td class='th'>Ссылка</td>
        <td>
{% for website in i.link_list %}
                <p style="margin: 0; padding: 0;">
                    <a href="{{ website }}" target="_blank">
                        {{ website }}
                    </a>
                </p>
{% endfor %}
        </td>
    </tr>
{% endif %}
{% if i.non_ia %}
    <tr>
        <td class='th'>Не Индоевроп</td>
        <td><i>{{ i.non_ia }}</i></td>
    </tr>
{% endif %}
{% if friendly.sanskrit %}
    <tr>
        <td class='th'>Санскрит</td>
        <td><i>{{ friendly.sanskrit }}</i></td>
    </tr>
{% endif %}
{% if i.root_key %}
{% if i.rt.sanskrit_root and i.rt.sanskrit_root != "-" %}
    <tr>
        <td class='th'>Санск. Корень</td>
        <td>
            <i>
                {{ i.rt.sanskrit_root }} {{ i.rt.sanskrit_root_class }} ({{ i.rt.sanskrit_root_ru_meaning }})
            </i>
        </td>
    </tr>
{% endif %}
{% endif %}
</table>