{{ d.header }}
<body>
<div class="root">
    <p>
        <b>{{ d.r.root_clean }}</b> 
        {{ d.r.root_group }} 
        {{ d.r.root_sign }} 
        ({{ d.r.root_ru_meaning }}) 
        <span class="gray">{{ d.count }}</span>
    </p>
</div>

<div class="button-box">
    {% if d.r.root_info %}
    <a class="dpd-button" href="#" data-target="ru_root_info_{{ d.r.root_ }}">инфо</a>
    {% endif %}
    {% if d.r.root_matrix %}
    <a class="dpd-button" href="#" data-target="ru_root_matrix_{{ d.r.root_ }}">матрица</a>
    {% endif %}
    {% for fr in d.frs %}
    <a class="dpd-button" href="#" data-target="ru_root_family_{{ fr.root_family_ }}">
        {{ fr.root_family_clean }}
    </a>
    {% endfor %}
</div>

{% if d.r.root_info %}
<div id="ru_root_info_{{ d.r.root_ }}" class="root content hidden">
    <table class="root_info">
        <tr>
            <th>Корень</th>
            <td>{{ d.r.root }}</td>
        </tr>
        <tr>
            <th>Значение</th>
            <td>{{ d.r.root_ru_meaning }}</td>
        </tr>
        <tr>
            <th>Группа</th>
            <td>{{ d.r.root_group }}</td>
        </tr>
        <tr>
            <th>Знак</th>
            <td>{{ d.r.root_sign }}</td>
        </tr>
        {% if d.r.sanskrit_root %}
        <tr>
            <th>Санскрит</th>
            <td><i>{{ d.r.sanskrit_root }} {{ d.r.sanskrit_root_class }} ({{ d.r.sanskrit_root_ru_meaning }})</i></td>
        </tr>
        {% endif %}
        {% if d.r.root_example %}
        <tr>
            <th>Пример</th>
            <td>{{ d.r.root_example }}</td>
        </tr>
        {% endif %}
        {% if d.ru_root_info %}
        <tr>
            <th>Инфо</th>
            <td>{{ d.ru_root_info }}</td>
        </tr>
        {% endif %}
    </table>
</div>
{% endif %}

{% if d.r.root_matrix %}
<div id="ru_root_matrix_{{ d.r.root_ }}" class="root content hidden">
    <table class="root_matrix">
        <tr>
            <th colspan="2">Матрица корня</th>
        </tr>
        <tr>
            <td colspan="2">{{ d.ru_root_matrix }}</td>
        </tr>
    </table>
</div>
{% endif %}

{% for fr in d.frs %}
<div id="ru_root_family_{{ fr.root_family_ }}" class="root content hidden">
    {{ fr.html_ru }}
</div>
{% endfor %}

</body></html>
