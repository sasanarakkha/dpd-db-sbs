<div class="button-box">
    <a class="dpd-button" href="#" data-target="sbs_root_info_{{ r.root_ }}">root info</a>
    <a class="dpd-button" href="#" data-target="sbs_root_matrix_{{ r.root_ }}">root
        matrix</a>
{% for fr in frs %}
    <a class="dpd-button" href="#"
        data-target="sbs_family_root_{{ r.root_ }}_{{ fr.root_family_ }}">{{ fr.root_family }}</a>
{% endfor %}
</div>
<div id="sbs_root_info_{{ r.root_ }}" class="dpd content hidden">
    {{ r.root_info }}
</div>
<div id="sbs_root_matrix_{{ r.root_ }}" class="dpd content hidden">
    {{ r.root_matrix }}
</div>
{% for fr in frs %}
<div id="sbs_family_root_{{ r.root_ }}_{{ fr.root_family_ }}" class="dpd content hidden">
    {{ fr.html }}
</div>
{% endfor %}