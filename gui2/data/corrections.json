        "non_ia": "",
        "sanskrit": "bandhana + avakāsa",
        "source_1": "VIN1.4.3.2",
        "sutta_1": "ūnapañcabandhanasikkhāpadaṃ",
        "example_1": "abandhan'okāso nāma patto yassa dv'aṅgulā rāji na hoti. <b>bandhan'okāso</b> nāma patto yassa dv'aṅgulā rāji hoti. navo nāma patto viññattiṃ upādāya vuccati.",
        "source_2": "",
